@page "/register"
@rendermode InteractiveServer
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Nav

<PageTitle>Register – CodePrep</PageTitle>

<div class="auth-page">
    <div class="auth-hero">
        <div class="auth-hero-content">
            <div style="font-size:2.5rem;margin-bottom:12px;">⚡</div>
            <h1>Start your coding journey</h1>
            <p>Join thousands of developers preparing for competitive programming contests and tech interviews.</p>
            <div class="auth-features">
                <div class="auth-feature"><div class="auth-feature-dot"></div> Free forever for core features</div>
                <div class="auth-feature"><div class="auth-feature-dot"></div> Track progress across topics</div>
                <div class="auth-feature"><div class="auth-feature-dot"></div> AI roadmap & quiz generator</div>
            </div>
        </div>
    </div>

    <div class="auth-form-side">
        <div class="auth-form-card">
            <h2>Create account</h2>
            <p class="subtitle">It only takes a minute</p>

            <EditForm Model="_model" OnValidSubmit="HandleRegister">
                <div class="form-group">
                    <label class="form-label">Username</label>
                    <InputText class="form-control" @bind-Value="_model.UserName" placeholder="coder123" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_model.Email" placeholder="you@example.com" />
                </div>
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <InputText type="password" class="form-control" @bind-Value="_model.Password" placeholder="Min 6 characters" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div style="background:var(--danger-soft);color:var(--danger);padding:10px 14px;border-radius:8px;font-size:.85rem;margin-bottom:16px;">
                        @_error
                    </div>
                }
                @if (!string.IsNullOrEmpty(_success))
                {
                    <div style="background:var(--success-soft);color:var(--success);padding:10px 14px;border-radius:8px;font-size:.85rem;margin-bottom:16px;">
                        @_success
                    </div>
                }

                <button type="submit" class="btn btn-primary" style="width:100%;" disabled="@_busy">
                    @(_busy ? "Creating account..." : "Create Account")
                </button>
            </EditForm>

            <p style="text-align:center;margin-top:20px;font-size:.875rem;color:var(--text-muted);">
                Already have an account? <a href="/login" style="font-weight:600;">Sign in</a>
            </p>
        </div>
    </div>
</div>

@code {
    private RegisterRequest _model = new();
    private bool _busy;
    private string? _error;
    private string? _success;

    private async Task HandleRegister()
    {
        _busy = true;
        _error = null;
        _success = null;

        var (ok, msg) = await Auth.RegisterAsync(_model);
        if (ok)
        {
            _success = msg;
            Toast.ShowSuccess(msg);
            await Task.Delay(1200);
            Nav.NavigateTo("/login");
        }
        else
        {
            _error = msg;
        }
        _busy = false;
    }
}
