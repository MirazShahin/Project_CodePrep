@page "/topics"
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Topics – CodePrep</PageTitle>

<div class="page-header">
    <div>
        <h1>Topics</h1>
        <div class="subtitle">Browse learning topics by category</div>
    </div>
</div>

<div class="toolbar" style="margin-bottom:24px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
    <div class="search-bar" style="flex:1;min-width:220px;max-width:360px;">
        <span style="color:var(--text-muted);">🔍</span>
        <input type="text" placeholder="Search topics..." @bind="_keyword" @bind:event="oninput"
               @onkeydown="OnSearchKey" />
    </div>
    <select class="form-control" style="width:auto;min-width:160px;" @bind="_category" @bind:after="LoadTopics">
        <option value="">All Categories</option>
        <option value="Competitive Programming">Competitive Programming</option>
        <option value="Interview Prep">Interview Prep</option>
        <option value="Data Structures">Data Structures</option>
        <option value="Algorithms">Algorithms</option>
    </select>
    <button class="btn btn-primary" @onclick="LoadTopics" disabled="@_loading">Search</button>
</div>

@if (_loading)
{
    <LoadingSpinner Message="Loading topics..." />
}
else if (!_topics.Any())
{
    <EmptyState Icon="📚" Title="No topics found" Description="Try a different search or category." />
}
else
{
    var groups = _topics.GroupBy(t => string.IsNullOrEmpty(t.CategoryName) ? "General" : t.CategoryName)
                        .OrderBy(g => g.Key);

    @foreach (var g in groups)
    {
        <div style="margin-bottom:32px;">
            <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:14px;color:var(--text-secondary);">
                @g.Key <span class="badge badge-muted" style="margin-left:8px;">@g.Count()</span>
            </h2>
            <div class="grid-3">
                @foreach (var t in g)
                {
                    <a href="/topics/@t.Id" class="card topic-card" style="text-decoration:none;color:inherit;display:block;">
                        <div class="card-body">
                            <div style="display:flex;align-items:flex-start;gap:12px;">
                                <div class="stat-icon purple" style="width:42px;height:42px;font-size:1.1rem;">
                                    @(string.IsNullOrEmpty(t.Icon) ? "📖" : t.Icon)
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <h3 style="font-weight:700;font-size:1rem;margin-bottom:4px;color:var(--text);">@t.Name</h3>
                                    <p style="color:var(--text-muted);font-size:.82rem;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                        @(t.Description ?? "No description")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
}

@code {
    private List<TopicDto> _topics = new();
    private bool _loading = true;
    private string _keyword = "";
    private string _category = "";

    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryParam))
            _keyword = QueryParam;
        await LoadTopics();
    }

    private async Task LoadTopics()
    {
        _loading = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(_keyword) || !string.IsNullOrWhiteSpace(_category))
                _topics = await Api.SearchTopicsAsync(_keyword, string.IsNullOrEmpty(_category) ? null : _category);
            else
                _topics = await Api.GetTopicsAsync();
        }
        catch
        {
            _topics = new();
            Toast.Show("Could not load topics. Is the API running?", "error");
        }
        _loading = false;
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadTopics();
    }
}
